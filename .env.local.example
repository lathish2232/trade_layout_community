# API Configuration
# Backend server URL - change this to match your backend server
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# For production, you might want to use:
# NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.com

# For staging/development environments:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.100:8001
# NEXT_PUBLIC_API_BASE_URL=https://staging-api.yourdomain.com
